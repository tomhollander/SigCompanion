<Project>
  <PropertyGroup>
    <!-- Sets AssemblyVersion, FileVersion, and InformationalVersion -->
    <Version>1.3.0</Version>
    
    <!-- Android-specific version code (must be an integer that increments per store release) -->
    <ApplicationVersion>130</ApplicationVersion>
    <ApplicationDisplayVersion>1.3.0</ApplicationDisplayVersion>
  </PropertyGroup>
</Project>