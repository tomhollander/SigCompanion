<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigCompanion.ViewModels"
             x:Class="SigCompanion.Views.TransposedEnergyTablePart"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="Auto,*,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="40" RowSpacing="10">
        <Image Grid.Column="1" Grid.Row="0" Source="/Assets/icon_home.png" Width="36" Height="36" HorizontalAlignment="Center" />
        <Image Grid.Column="2" Grid.Row="0" Source="/Assets/icon_solar.png" Width="36" Height="36" HorizontalAlignment="Center" />
        <Image Grid.Column="3" Grid.Row="0" Source="/Assets/icon_grid.png" Width="36" Height="36" HorizontalAlignment="Center" />
        <Image Grid.Column="4" Grid.Row="0" Source="/Assets/icon_battery.png" Width="36" Height="36" HorizontalAlignment="Center" />

        <TextBlock Grid.Column="0" Grid.Row="1" Text="Yesterday" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding HomeYesterdayKwh, StringFormat='{}{0:0}'}" Foreground="#2AA7E0" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="2" Grid.Row="1" Text="{Binding SolarYesterdayKwh, StringFormat='{}{0:0}'}" Foreground="#E0B800" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="3" Grid.Row="1" Spacing="2" HorizontalAlignment="Center" Opacity="0.8">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding IsYesterdayGridExportVisible}">
                <Image Source="/Assets/icon_grid_export.png" Width="20" Height="20" />
                <TextBlock Text="{Binding GridExportYesterdayKwh, StringFormat='{}{0:0}'}" Foreground="#CCCCCC" FontSize="22" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/icon_grid_import.png" Width="20" Height="20" />
                <TextBlock Text="{Binding GridImportYesterdayKwh, StringFormat='{}{0:0}'}" Foreground="#CCCCCC" FontSize="22" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="4" Grid.Row="1" Spacing="2" HorizontalAlignment="Center" Opacity="0.8">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/icon_battery_export.png" Width="20" Height="20" />
                <TextBlock Text="{Binding BatteryExportYesterdayKwh, StringFormat='{}{0:0}'}" Foreground="#3CC83C" FontSize="22" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/icon_battery_import.png" Width="20" Height="20" />
                <TextBlock Text="{Binding BatteryImportYesterdayKwh, StringFormat='{}{0:0}'}" Foreground="#3CC83C" FontSize="22" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Column="0" Grid.Row="2" Text="Today" Foreground="#AAAAAA" FontSize="14" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding HomeTodayKwh, StringFormat='{}{0:0}'}" Foreground="#2AA7E0" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="2" Grid.Row="2" Text="{Binding SolarTodayKwh, StringFormat='{}{0:0}'}" Foreground="#E0B800" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="3" Grid.Row="2" Spacing="2" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" IsVisible="{Binding IsTodayGridExportVisible}">
                <Image Source="/Assets/icon_grid_export.png" Width="20" Height="20" />
                <TextBlock Text="{Binding GridExportTodayKwh, StringFormat='{}{0:0}'}" Foreground="#FFFFFF" FontSize="22" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/icon_grid_import.png" Width="20" Height="20" />
                <TextBlock Text="{Binding GridImportTodayKwh, StringFormat='{}{0:0}'}" Foreground="#FFFFFF" FontSize="22" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="4" Grid.Row="2" Spacing="2" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/icon_battery_export.png" Width="20" Height="20" />
                <TextBlock Text="{Binding BatteryExportTodayKwh, StringFormat='{}{0:0}'}" Foreground="#3CC83C" FontSize="22" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <Image Source="/Assets/icon_battery_import.png" Width="20" Height="20" />
                <TextBlock Text="{Binding BatteryImportTodayKwh, StringFormat='{}{0:0}'}" Foreground="#3CC83C" FontSize="22" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
