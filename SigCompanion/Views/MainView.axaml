<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SigCompanion.ViewModels"
             xmlns:views="using:SigCompanion.Views"
             xmlns:controls="using:SigCompanion.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SigCompanion.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Background="#000000">
        <Border IsVisible="{Binding IsMainPageVisible}" Background="#000000" Padding="18" MinHeight="640">
            <Grid ColumnDefinitions="1.1*,1*" ColumnSpacing="24" RowDefinitions="Auto,*">
                <Button Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="36"
                        Height="36"
                        Padding="6"
                        Command="{Binding OpenSettingsCommand}">
                    <Image Source="/Assets/settings.png" Stretch="Uniform" />
                </Button>

                <StackPanel Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" Margin="0,28,0,0" Spacing="8">
                    <Grid Width="360" Height="360">
                        <controls:BatteryGaugeControl StateOfCharge="{Binding BatterySocValue}" IsGridConnected="{Binding IsGridConnected}" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <Image Source="/Assets/grid_disconnected.png"
                                   Width="34"
                                   Height="34"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding IsGridDisconnected}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Image Source="/Assets/icon_battery.png" Width="24" Height="24" />
                                <TextBlock Text="{Binding BatterySoc}" Foreground="#FFFFFF" FontSize="44" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Placeholder: Element 2" Foreground="#AAAAAA" FontSize="20" />
                </StackPanel>

                <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="0,28,0,0" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="20">
                    <Border Grid.Row="0" Background="#101010" CornerRadius="6" Padding="16">
                        <TextBlock Text="Placeholder: Element 3" Foreground="#DDDDDD" FontSize="22" />
                    </Border>

                    <Border Grid.Row="1" Background="#101010" CornerRadius="6" Padding="16">
                        <TextBlock Text="Placeholder: Element 4" Foreground="#DDDDDD" FontSize="22" />
                    </Border>

                    <Border Grid.Row="2" Background="#101010" CornerRadius="6" Padding="16">
                        <TextBlock Text="Placeholder: Element 5" Foreground="#DDDDDD" FontSize="22" />
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <views:SettingsView IsVisible="{Binding IsSettingsPageVisible}" />

        <Border IsVisible="{Binding IsLoginPageVisible}"
                Background="#AA000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Width="420"
                    Padding="20"
                    CornerRadius="8"
                    Background="#111111"
                    BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sign In" Foreground="#FFFFFF" FontWeight="Bold" FontSize="20" />

                    <TextBlock Text="Username" Foreground="#CCCCCC" />
                    <TextBox Text="{Binding Username, Mode=TwoWay}" Watermark="Username" />

                    <TextBlock Text="Password" Foreground="#CCCCCC" />
                    <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" Watermark="Password" />

                    <CheckBox IsChecked="{Binding SavePassword, Mode=TwoWay}" Content="Save password" />

                    <Button Content="Sign In" Command="{Binding SignInCommand}" Width="120" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CCCCCC" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
