<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SigCompanion.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SigCompanion.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="10">
            <TextBlock Text="Temporary Sigen Test UI" FontWeight="Bold" FontSize="18" />

            <StackPanel Spacing="8" IsVisible="{Binding IsLoginPageVisible}">
                <TextBlock Text="Login" FontWeight="Bold" />

                <TextBlock Text="Username" />
                <TextBox Text="{Binding Username, Mode=TwoWay}" Watermark="Username" />

                <TextBlock Text="Password" />
                <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" Watermark="Password" />

                <CheckBox IsChecked="{Binding SavePassword, Mode=TwoWay}" Content="Save password" />

                <Button Content="Sign In" Command="{Binding SignInCommand}" Width="120" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding IsMainPageVisible}">
                <TextBlock Text="Main" FontWeight="Bold" />

                <TextBlock Text="Battery SOC" FontWeight="Bold" />
                <TextBlock Text="{Binding BatterySoc}" />

                <TextBlock Text="Charge Status" FontWeight="Bold" />
                <TextBlock Text="{Binding BatteryStatus}" />

                <TextBlock Text="Grid Status" FontWeight="Bold" />
                <TextBlock Text="{Binding GridStatus}" />

                <TextBlock Text="PV Power" FontWeight="Bold" />
                <TextBlock Text="{Binding PvPower}" />

                <TextBlock Text="Grid Power" FontWeight="Bold" />
                <TextBlock Text="{Binding GridPower}" />

                <TextBlock Text="EV Power" FontWeight="Bold" />
                <TextBlock Text="{Binding EvPower}" />

                <TextBlock Text="AC Power" FontWeight="Bold" />
                <TextBlock Text="{Binding AcPower}" />

                <TextBlock Text="Load Power" FontWeight="Bold" />
                <TextBlock Text="{Binding LoadPower}" />

                <TextBlock Text="Heat Pump Power" FontWeight="Bold" />
                <TextBlock Text="{Binding HeatPumpPower}" />

                <TextBlock Text="Battery Power" FontWeight="Bold" />
                <TextBlock Text="{Binding BatteryPower}" />

                <TextBlock Text="Station Card Totals (kWh)" FontWeight="Bold" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="2*,*,*" Margin="0,0,0,4">
                    <TextBlock Grid.Column="0" Text="Card" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="Today" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="Yesterday" FontWeight="Bold" />
                </Grid>
                <ItemsControl ItemsSource="{Binding HistoricalStationCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,*,*" Margin="0,0,0,2">
                                <TextBlock Grid.Column="0" Text="{Binding CardKey}" />
                                <TextBlock Grid.Column="1" Text="{Binding TodayKwh}" />
                                <TextBlock Grid.Column="2" Text="{Binding YesterdayKwh}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Chart Data Today (raw)" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBox Text="{Binding TodayChartDataJson}" IsReadOnly="True" AcceptsReturn="True" Height="100" TextWrapping="Wrap" />

                <TextBlock Text="Chart Data Yesterday (raw)" FontWeight="Bold" Margin="0,8,0,0" />
                <TextBox Text="{Binding YesterdayChartDataJson}" IsReadOnly="True" AcceptsReturn="True" Height="100" TextWrapping="Wrap" />

                <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Width="120" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding IsSettingsPageVisible}">
                <TextBlock Text="Settings" FontWeight="Bold" />

                <TextBlock Text="Active System" />
                <ComboBox ItemsSource="{Binding Systems}"
                          SelectedItem="{Binding SelectedSystem, Mode=TwoWay}"
                          DisplayMemberBinding="{Binding SystemName}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Back" Command="{Binding BackToMainCommand}" Width="100" />
                    <Button Content="Sign Out" Command="{Binding SignOutCommand}" Width="100" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Status" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
