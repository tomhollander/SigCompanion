<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SigCompanion.ViewModels"
             xmlns:views="using:SigCompanion.Views"
             xmlns:controls="using:SigCompanion.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SigCompanion.Views.MainView"
             x:DataType="vm:MainViewModel">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid Background="#000000">
        <Border IsVisible="{Binding IsMainPageVisible}" Background="#000000">
            <Grid>
                <Image Source="/Assets/app_logo.png" HorizontalAlignment="Center" VerticalAlignment="Top" Height="15" Opacity="0.8" />
                <TextBlock Text="{Binding CurrentTimeText}" IsVisible="{Binding ShowClock}" Foreground="#808080" FontSize="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,10,0,0" />

                <!-- 1. Large landscape (1000x800 shared reference, scaled to fit) -->
                <Viewbox x:Name="LargeLandscapeLayout" IsVisible="False" Margin="12,24,12,12">
                    <Grid Width="1000" Height="800" ColumnDefinitions="Auto, *" ColumnSpacing="24">
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="28">
                            <views:GaugePart />
                            <views:FlowPart />
                        </StackPanel>

                        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
                            <views:EnergyTablePart Grid.Row="0" HorizontalAlignment="Center" />
                            <views:ChartPart Grid.Row="1" />
                        </Grid>
                    </Grid>
                </Viewbox>

                <!-- 2. Large portrait (1000x700 shared reference, scaled to fit) -->
                <Viewbox x:Name="LargePortraitLayout" IsVisible="False" Margin="12,24,12,12">
                    <Grid Width="700" Height="1000" RowDefinitions="4*,3*,3*" RowSpacing="16">
                        <Grid Grid.Row="0" ColumnDefinitions="*,*" ColumnSpacing="16">
                            <views:GaugePart Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <views:FlowPart Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <views:TransposedEnergyTablePart Grid.Row="1" />
                        <views:ChartPart Grid.Row="2" />
                    </Grid>
                </Viewbox>

                <!-- 3. Phone landscape (800x480 reference, two swipeable pages) -->
                <Viewbox x:Name="PhoneLandscapeLayout" IsVisible="False" Margin="8,12,8,8">
                    <Grid Width="800" Height="480" Background="Transparent"
                          PointerPressed="OnPagerPointerPressed"
                          PointerReleased="OnPagerPointerReleased">
                        <Grid x:Name="LandscapePage1" ColumnDefinitions="*,*">
                            <Viewbox Grid.Column="0" Width="380" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <views:GaugePart />
                            </Viewbox>
                            <Viewbox Grid.Column="1" Width="380" Height="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <views:FlowPart />
                            </Viewbox>
                        </Grid>
                        <Grid x:Name="LandscapePage2" RowDefinitions="Auto,*" RowSpacing="8" IsVisible="False">
                            <views:TransposedEnergyTablePart Grid.Row="0" HorizontalAlignment="Center" />
                            <views:ChartPart Grid.Row="1" />
                        </Grid>
                    </Grid>
                </Viewbox>

                <!-- 4. Phone portrait (440x860 reference, two swipeable pages) -->
                <Viewbox x:Name="PhonePortraitLayout" IsVisible="False" Margin="8,12,8,8">
                    <Grid Width="440" Height="860" Background="Transparent"
                          PointerPressed="OnPagerPointerPressed"
                          PointerReleased="OnPagerPointerReleased">
                        <StackPanel x:Name="PortraitPage1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                            <Viewbox Width="420" Height="420">
                                <views:GaugePart />
                            </Viewbox>
                            <Viewbox Width="420" Height="300">
                                <views:FlowPart />
                            </Viewbox>
                        </StackPanel>
                        <Grid x:Name="PortraitPage2" RowDefinitions="Auto,*" RowSpacing="12" IsVisible="False">
                            <views:EnergyTablePart Grid.Row="0" HorizontalAlignment="Center" />
                            <views:ChartPart Grid.Row="1" />
                        </Grid>
                    </Grid>
                </Viewbox>

                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="8"
                        Width="36"
                        Height="36"
                        Padding="6"
                        Background="Transparent"
                        Command="{Binding OpenSettingsCommand}">
                    <Image Source="/Assets/settings.png" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <views:SettingsView IsVisible="{Binding IsSettingsPageVisible}" />

        <Border IsVisible="{Binding IsLoginPageVisible}"
                Background="#AA000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Width="380"
                    Padding="20"
                    CornerRadius="8"
                    Background="#111111"
                    BorderBrush="#2E2E2E"
                    BorderThickness="1"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sign In with your MySigen Account" Foreground="#FFFFFF" FontWeight="Bold" FontSize="20" />

                    <TextBlock Text="Username" Foreground="#CCCCCC" />
                    <TextBox Text="{Binding Username, Mode=TwoWay}" Watermark="Username" />

                    <TextBlock Text="Password" Foreground="#CCCCCC" />
                    <TextBox Text="{Binding Password, Mode=TwoWay}" PasswordChar="*" Watermark="Password" />

                    <CheckBox IsChecked="{Binding SavePassword, Mode=TwoWay}" Content="Save password" />

                    <Button Content="Sign In" HorizontalContentAlignment="Center" Command="{Binding SignInCommand}" Width="120" />

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CCCCCC" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
