<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SigCompanion.Controls"
             xmlns:vm="using:SigCompanion.ViewModels"
             x:Class="SigCompanion.Views.FlowPart"
             x:DataType="vm:MainViewModel">
    <Grid Width="250" Height="210" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Image Source="/Assets/flow-background.png" Width="170" Height="145" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <controls:PowerFlowDiagram Width="170" Height="145" HorizontalAlignment="Center" VerticalAlignment="Center" Flows="{Binding PowerFlows}" />
        <TextBlock Text="{Binding FlowSolarText}" Foreground="#E0B800" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Top" />
        <TextBlock Text="{Binding FlowGridText}" Foreground="#CCCCCC" FontSize="32" HorizontalAlignment="Right" VerticalAlignment="Top" />
        <TextBlock Text="{Binding FlowBatteryText}" Foreground="#3CC83C" FontSize="32" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        <TextBlock Text="{Binding FlowHomeText}" Foreground="#2AA7E0" FontSize="32" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
</UserControl>
