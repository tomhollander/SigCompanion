<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:SigCompanion.Controls"
             xmlns:vm="using:SigCompanion.ViewModels"
             x:Class="SigCompanion.Views.FlowPart"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Width="260" Height="220" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Row="0">
            <Ellipse x:Name="background" Width="150" Height="150" Stroke="#202020" StrokeThickness="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="/Assets/flow-background.png" Width="170" Height="145" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <controls:PowerFlowDiagram Width="175" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Flows="{Binding PowerFlows}" />
            <TextBlock Text="{Binding FlowSolarText}" Foreground="#FFC400" FontSize="42" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <TextBlock Text="{Binding FlowGridText}" Foreground="#FFFFFF" FontSize="42" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <TextBlock Text="{Binding FlowBatteryText}" Foreground="#3CC83C" FontSize="42" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding FlowHomeText}" Foreground="#2AA7E0" FontSize="42" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
        <TextBlock Text="kW" FontSize="16" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#AAAAAA"/> 
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Row="1" Margin="0,-8,0,0">
            <Image x:Name="evIcon" Source="/Assets/icon_ev.png" Width="20" Height="20" IsVisible="{Binding EvIconVisible}" Margin="0,0,12,0" />
            <TextBlock Text="{Binding FlowEvText}"  Grid.Row="1" Foreground="#DD6A6A" FontSize="24"  />
        </StackPanel>
    </Grid>
</UserControl>
