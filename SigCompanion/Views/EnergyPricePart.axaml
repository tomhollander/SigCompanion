<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SigCompanion.ViewModels"
             x:Class="SigCompanion.Views.EnergyPricePart"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.price-strip">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="12" />
        </Style>
        <Style Selector=":is(UserControl).stacked StackPanel.price-strip">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector=":is(UserControl).live-only TextBlock.daily-total">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(UserControl).total-only StackPanel.live-price">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </UserControl.Styles>

    <StackPanel Classes="price-strip" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Classes="live-price" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                    ToolTip.Tip="{Binding EnergyPrices.Buy.TariffName}">
            <Image Source="/Assets/icon_grid_import.png" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BuyEnergyPriceText}" Foreground="#307EDD" FontSize="32" />
            <Border Classes="badge" Background="{Binding BuyPriceLevelBrush}"
                    IsVisible="{Binding EnergyPrices.Buy.PriceLevelName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                <TextBlock Text="{Binding EnergyPrices.Buy.PriceLevelName}" Foreground="#000000" FontSize="14" />
            </Border>
        </StackPanel>
        <StackPanel Classes="live-price" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                    ToolTip.Tip="{Binding EnergyPrices.Sell.TariffName}">
            <Image Source="/Assets/icon_grid_export_yellow.png" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SellEnergyPriceText}" Foreground="#CECB65" FontSize="32" />
            <Border Classes="badge" Background="{Binding SellPriceLevelBrush}"
                    IsVisible="{Binding EnergyPrices.Sell.PriceLevelName, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}">
                <TextBlock Text="{Binding EnergyPrices.Sell.PriceLevelName}" Foreground="#000000" FontSize="14" />
            </Border>
        </StackPanel>
        <TextBlock Classes="daily-total" Foreground="#BEBEBE" FontSize="26" HorizontalAlignment="Center">
            <Run Text="Today:&#160;" /><Run Text="{Binding TodayEnergyTotalText}" Foreground="{Binding TodayEnergyTotalBrush}" />
        </TextBlock>
    </StackPanel>
</UserControl>
